{
  "$meta": {
    "name": "Kids Mind Design Tokens",
    "version": "1.1.0",
    "locale": "zh-CN",
    "source": "视觉系统设计需求清单 v1.0",
    "contrastMethod": "WCAG 2.x 相对亮度公式，本机实算；AA=≥4.5:1，大字/非文本=≥3:1",
    "cjkLetterSpacing": 0,
    "note": "颜色 token 与 tokens.css 同名，可无歧义映射；usage 字段为落地约束，不是建议"
  },
  "color": {
    "surface": {
      "bg":            { "$value": "#F5F2EB", "usage": "页面底色，唯一允许的页面级背景", "status": "沿用" },
      "surface":       { "$value": "#FFFDF9", "usage": "卡片/面板/弹窗，禁止再定义第 3 种卡片白", "status": "沿用" },
      "surfaceSoft":   { "$value": "#F0ECE3", "usage": "浅底块、列表 hover 底", "status": "调整" },
      "surfaceSunken": { "$value": "#E9E4D9", "usage": "内凹陷区（只读字段、引用块）", "status": "新增" },
      "surfaceInverse":{ "$value": "#14332D", "usage": "仅桌面侧边栏与反白卡片；移动端不得使用", "status": "调整(原 #173c36)" }
    },
    "text": {
      "inkDeep":  { "$value": "#0F2A25", "usage": "页面主标题（H1/Display）", "contrastOnSurface": 13.6 },
      "ink":      { "$value": "#1C3B35", "usage": "正文主文本、列表主标题", "contrastOnSurface": 11.97 },
      "inkSoft":  { "$value": "#43554F", "usage": "次级正文、AI 回答正文", "contrastOnSurface": 7.80 },
      "muted":    { "$value": "#5C6B66", "usage": "元信息/单位/时间戳；禁止承载操作说明与错误文案", "contrastOnSurface": 5.51, "contrastOnBg": 5.01 },
      "iconMuted":{ "$value": "#7C8A84", "usage": "装饰性图标下限色，非文本但守 3:1", "contrastOnSurface": 3.55 },
      "onInverse":{ "$value": "#F2F5F1", "usage": "深色底主文本", "contrast": 13.63 },
      "onInverseMuted": { "$value": "#B6C9C3", "usage": "深色底次级文本（侧边栏导航默认态）", "contrast": 7.87 }
    },
    "line": {
      "hairline":   { "$value": "#E2DDD1", "usage": "纯装饰分隔线，禁止作为控件边界" },
      "line":       { "$value": "#DED8CB", "usage": "列表/区块分隔线" },
      "lineStrong": { "$value": "#8A8676", "usage": "输入框/选择器/复选框描边，满足 1.4.11 的 3:1", "contrastOnSurface": 3.59 }
    },
    "primary": {
      "50":  { "$value": "#FDF1EC", "usage": "主色极浅底（选中项背景）" },
      "100": { "$value": "#FAE1D6", "usage": "主色浅底（Chip 激活、提示底）" },
      "200": { "$value": "#F3C4B0", "usage": "插画/图形辅助" },
      "300": { "$value": "#EFAE90", "usage": "品牌块与 App 图标底色（配深墨绿字）" },
      "400": { "$value": "#E48E68", "usage": "插画主色" },
      "500": { "$value": "#D96F45", "usage": "品牌主色：图形、焦点环、小面积强调。禁止承载白字正文（3.33:1）" },
      "600": { "$value": "#C25E3B", "usage": "浅底上的强调图标与 hover 底" },
      "700": { "$value": "#B4552F", "usage": "主按钮底 + 白字，全站唯一主行动色", "contrastWhiteText": 4.91 },
      "800": { "$value": "#A04A28", "usage": "按下态 / 浅底链接与强调文字", "contrastOnSurface": 5.50 },
      "900": { "$value": "#7E3A1F", "usage": "主色上的深色叠层" }
    },
    "aux": {
      "sage100":  { "$value": "#DCE9E2", "usage": "成长/安全类浅底，沿用" },
      "sage600":  { "$value": "#4E786A", "usage": "鼠尾草绿图标与文本（替代原 #91afa5 做文本）", "contrastOnSurface": 4.90 },
      "sage700":  { "$value": "#3F6B5E", "usage": "成功文本、安全等级文本", "contrastOnSurface": 5.95 },
      "cream100": { "$value": "#FFF1D5", "usage": "奶油浅底（辅食/里程碑类）" },
      "cream700": { "$value": "#7A5A20", "usage": "奶油底上的文本", "contrast": 5.68 },
      "lilac100": { "$value": "#ECE7F0", "usage": "睡眠类浅底" },
      "lilac700": { "$value": "#5E5180", "usage": "睡眠类文本", "contrast": 5.82 },
      "mist100":  { "$value": "#E7EEF3", "usage": "体检/信息类浅底" },
      "mist700":  { "$value": "#3A5A70", "usage": "体检/信息类文本", "contrast": 6.23 }
    },
    "semantic": {
      "$usage": "只用于「操作反馈」（Toast、内联错误、表单校验、状态徽标）；禁止用于医疗风险分级",
      "success": { "bg": "#E1EEE7", "text": "#2F5C4E", "border": "#A8C9BA", "contrast": 6.37 },
      "warning": { "bg": "#FBE8CC", "text": "#8A4E0A", "border": "#E5BE83", "contrast": 5.52 },
      "danger":  { "bg": "#FBE3DF", "text": "#A3231B", "border": "#EBAFA6", "contrast": 6.10 },
      "info":    { "bg": "#E7EEF3", "text": "#3A5A70", "border": "#B4C8D8", "contrast": 6.23 }
    },
    "risk": {
      "$usage": "只用于「内容分级」（AI 回答、风险提示卡）。与 semantic 物理隔离：不同色阶、不同载体、不同图形",
      "$redundancy": "色相 + 左侧竖条墨量 + 徽标形状 + 固定文案，四重编码，灰度打印与红绿色盲下均可区分",
      "L1_high": {
        "label": "需立即就医", "bg": "#F7CFC8", "text": "#8F2A20", "border": "#D98C82", "bar": "#8F2A20",
        "barWidth": 4, "barStyle": "solid", "badgeStyle": "solid", "icon": "octagon-alert",
        "contrast": 5.84, "grayscaleL": 86.3
      },
      "L2_medium": {
        "label": "居家观察", "bg": "#F8E2B8", "text": "#7E4606", "border": "#E3B673", "bar": "#7E4606",
        "barWidth": 4, "barStyle": "solid", "badgeStyle": "outline", "icon": "triangle-alert",
        "contrast": 5.99, "grayscaleL": 90.7
      },
      "L3_routine": {
        "label": "常规建议", "bg": "#EDF5F0", "text": "#2F5C4E", "border": "#B4D3C6", "bar": "#2F5C4E",
        "barWidth": 2, "barStyle": "solid", "badgeStyle": "outline", "icon": "circle-check",
        "contrast": 6.85, "grayscaleL": 95.8
      },
      "L4_disclaimer": {
        "label": "建议不能替代专业诊疗", "bg": "#F1F0EA", "text": "#5A6660", "border": "#C9C6BB",
        "bar": "#5A6660", "barWidth": 0, "barStyle": "dashed-border", "badgeStyle": "dashed", "icon": "shield",
        "contrast": 5.25, "grayscaleL": 94.7
      }
    }
  },
  "radius": {
    "lg": { "$value": "28px", "usage": "Hero 卡、弹窗、大面板" },
    "md": { "$value": "20px", "usage": "标准卡片" },
    "sm": { "$value": "14px", "usage": "列表项、输入框、小按钮" },
    "xs": { "$value": "10px", "usage": "标签、内嵌块" },
    "pill": { "$value": "999px", "usage": "徽标、Chip" },
    "brand": { "$value": "20px 20px 20px 7px", "usage": "品牌块特征圆角，仅 Logo 位与品牌区使用" }
  },
  "shadow": {
    "1": { "$value": "0 1px 2px rgba(15,42,37,.06)", "usage": "极弱：内嵌块" },
    "soft": { "$value": "0 8px 28px rgba(35,58,50,.06)", "usage": "卡片静止态" },
    "strong": { "$value": "0 18px 50px rgba(35,58,50,.10)", "usage": "卡片 hover、登录卡" },
    "overlay": { "$value": "0 35px 90px rgba(8,30,26,.28)", "usage": "弹窗、抽屉" },
    "focusRing": { "$value": "0 0 0 3px rgba(180,85,47,.30)", "usage": "全站唯一浅底焦点环" },
    "focusRingInverse": { "$value": "0 0 0 3px rgba(240,185,159,.55)", "usage": "深色容器上的焦点环" }
  },
  "font": {
    "sans": {
      "$value": "\"Inter\",\"PingFang SC\",\"HarmonyOS Sans SC\",\"Microsoft YaHei\",system-ui,sans-serif",
      "usage": "UI 正文、控件、导航、元数据",
      "license": "Inter: SIL OFL 1.1；中文走系统字体，无授权成本"
    },
    "serif": {
      "$value": "\"Source Han Serif SC\",\"Noto Serif SC\",\"Songti SC\",\"Inter\",\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif",
      "usage": "H1/Display/故事正文/空状态大标题；不用于按钮与表格",
      "license": "思源宋体 Source Han Serif / Noto Serif SC：SIL OFL 1.1，可商用",
      "fallbackRule": "Webfont 未加载时 Windows 落到无衬线黑体，不得回落到 SimSun"
    },
    "num": {
      "$value": "\"Inter\",\"PingFang SC\",system-ui,sans-serif",
      "usage": "年龄/日期/身高体重/进度百分比，必须 font-variant-numeric: tabular-nums"
    }
  },
  "typeScale": {
    "display":   { "desktop": "clamp(32px,4.2vw,46px)", "mobile": "32px", "weight": 600, "lineHeight": 1.2,  "family": "serif", "usage": "登录页品牌名、空状态大标题" },
    "h1":        { "desktop": "clamp(24px,2.2vw,32px)", "mobile": "24px", "weight": 600, "lineHeight": 1.3,  "family": "serif", "usage": "页面主标题" },
    "h2":        { "desktop": "clamp(19px,1.5vw,22px)", "mobile": "19px", "weight": 600, "lineHeight": 1.35, "family": "sans",  "usage": "卡片区块标题" },
    "h3":        { "desktop": "17px", "mobile": "16px", "weight": 600, "lineHeight": 1.45, "family": "sans",  "usage": "列表项标题、弹窗标题" },
    "h4":        { "desktop": "15px", "mobile": "15px", "weight": 600, "lineHeight": 1.5,  "family": "sans",  "usage": "分组标题、表单区块" },
    "bodyLg":    { "desktop": "15px", "mobile": "16px", "weight": 400, "lineHeight": 1.8,  "family": "sans",  "usage": "AI 长文、故事正文" },
    "body":      { "desktop": "14px", "mobile": "15px", "weight": 400, "lineHeight": 1.7,  "family": "sans",  "usage": "UI 正文" },
    "bodySm":    { "desktop": "13px", "mobile": "14px", "weight": 400, "lineHeight": 1.6,  "family": "sans",  "usage": "卡片正文、辅助说明" },
    "caption":   { "desktop": "12px", "mobile": "12px", "weight": 500, "lineHeight": 1.55, "family": "sans",  "usage": "时间、单位、来源" },
    "micro":     { "desktop": "11px", "mobile": "11px", "weight": 600, "lineHeight": 1.5,  "family": "sans",  "usage": "全站最小字号下限；仅角标与免责小字，禁止再小" },
    "eyebrow":   { "desktop": "11px", "mobile": "11px", "weight": 800, "lineHeight": 1.2,  "family": "sans",  "letterSpacing": "0.08em", "transform": "uppercase", "usage": "仅拉丁短语（TODAY / GROWTH）；中文不使用字距" },
    "numeralLg": { "desktop": "28px", "mobile": "26px", "weight": 600, "lineHeight": 1.2,  "family": "num",   "usage": "关键数值（身高/体重/月龄）" }
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px",
    "padCard": { "desktop": "24px", "mobile": "18px" },
    "padCardLg": { "desktop": "28px", "mobile": "22px" },
    "gapCard": { "desktop": "16px", "mobile": "12px" },
    "gapSection": { "desktop": "32px", "mobile": "24px" }
  },
  "size": {
    "controlS": "32px", "controlM": "42px", "controlL": "50px",
    "inputDesktop": "46px", "inputMobile": "48px",
    "hitMin": "44px", "sidebarW": "228px", "contentMax": "1280px",
    "measureReading": "640px",
    "breakpoint": { "mobile": 390, "tablet": 768, "desktopContent": 1280, "large": 1440 }
  },
  "motion": {
    "duration": { "instant": "120ms", "fast": "160ms", "base": "240ms", "slow": "320ms" },
    "easing": {
      "standard": "cubic-bezier(.2,.8,.2,1)",
      "exit": "cubic-bezier(.4,0,1,1)",
      "emphasis": "cubic-bezier(.34,1.2,.64,1)"
    },
    "rule": "只动 transform 与 opacity；禁止动画 width/height/top/left",
    "typing": { "perChar": "18-28ms", "caretBlink": "1s steps(1)" },
    "skeleton": { "shimmer": "1.4s linear infinite" }
  },
  "z": { "base": 0, "sticky": 20, "nav": 30, "overlay": 50, "toast": 60 }
}
