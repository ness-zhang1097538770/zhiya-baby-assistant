# 复制本文件为 .env 后填入真实值（.env 已被 .gitignore 排除，不会进仓库）
# 不要在这里填真实 Key，也不要提交真实 Key。

# DeepSeek API Key（验收前必填）
DEEPSEEK_API_KEY=

# DeepSeek 接口地址（默认官方）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型标识符：已核实为 deepseek-flash（即产品经理说的"v4 flash"便宜款，非 pro）
DEEPSEEK_MODEL=deepseek-flash

# 模型调用超时（秒）
DEEPSEEK_TIMEOUT=60

# SQLite 数据库路径
DB_PATH=data/app.db

# 硅基流动 API Key（故事插画 + 朗读用，验收前必填）
SILICONFLOW_API_KEY=

# 硅基流动接口地址（默认官方）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 插画模型（文生图）
SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors

# 朗读模型（语音合成）
SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B

# ===== 医疗通道（问育儿）=====
# 百川开放平台 API Key：https://platform.baichuan-ai.com
# 不填则医疗通道自动关闭，一切照旧走 DeepSeek
BAICHUAN_API_KEY=

# 百川接口地址（默认官方）
BAICHUAN_BASE_URL=https://api.baichuan-ai.com/v1

# 医疗模型标识符
BAICHUAN_MODEL=Baichuan-M3-Plus

# 医疗模型超时（秒）
BAICHUAN_TIMEOUT=60

# 医疗通道总开关：false 关闭 / true 开启（出问题改这里秒级回滚）
MEDICAL_ENABLED=false

# 放量比例 0-100，按 child_id 稳定分桶。建议先 0 + 白名单自测，再 20，最后 100
MEDICAL_ROLLOUT_PERCENT=0

# 强制开启医疗通道的 child_id，逗号分隔（内部测试用），如 1,2,3
MEDICAL_WHITELIST_IDS=

# 是否把「健康监测」「伤害预防」两类也算医疗主题（默认否）
MEDICAL_SEMI_CATEGORIES=false
